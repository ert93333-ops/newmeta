NEXT_PUBLIC_APP_URL=https://app.example.com
HERMES_APP_URL=https://app.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_DB_URL=postgresql://postgres:strong-password@db.project-ref.supabase.co:5432/postgres
TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
TOKEN_ENCRYPTION_KEY_ID=release-YYYYMMDD
HERMES_OAUTH_STATE_SECRET=replace-with-at-least-32-character-oauth-state-secret
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://app.example.com/api/integrations/meta/callback
META_GRAPH_VERSION=v24.0
HERMES_META_OAUTH_MODE=live
HERMES_APPROVAL_EXECUTION_MODE=live
HERMES_RENDER_PIPELINE_MODE=live
HERMES_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
HERMES_WORKER_SECRET=replace-with-at-least-32-characters
